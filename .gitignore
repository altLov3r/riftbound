# Keep the repository focused on the Unity project and its documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/HANDOFF.md
!/TASKS.md
!/ASSET_REQUESTS.md
!/CHARACTER_UPDATE.md
!/PROTOTYPE.md
!/Assets/
!/Packages/
!/ProjectSettings/
!/Docs/
!/.github/

# Unity caches, local state, diagnostics and the previous VCS stay local.
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Bb]uilds/
**/[Bb]uild/
**/[Uu]ser[Ss]ettings/
**/.plastic/
**/.code-check/
**/.vs/
**/.idea/
**/.DS_Store
**/Thumbs.db
**/*.csproj
**/*.sln
**/*.slnx
**/*.user
**/*.pidb
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db
**/*.log
**/*.tmp
**/*.bak
**/*.request
**/.env
**/.env.*
**/*.keystore
**/*.jks
**/*.pfx
**/*.p12
/Assets/StreamingAssets/aa/
/Assets/StreamingAssets/aa.meta
/Assets/Resources/PerformanceTestRun*.json
/Assets/Resources/PerformanceTestRun*.json.meta

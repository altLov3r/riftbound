            },
            {
              "field": "main.complete",
              "key": "",
              "boolValue": false,
              "intValue": 0
            }
          ],
          "text": "Stolen Supplies"
        },
        {
          "lineId": "abe.main2.title",
          "channel": "main_title",
          "scope": "viewer",
          "topicId": "",
          "priority": 50,
          "conditions": [
            {

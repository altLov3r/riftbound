    {
      "profileId": "abe",
      "actorKind": "main_quest_giver",
      "legacyName": "Abe",
      "enemyId": "",
      "fallbackText": "Keep the road clear, and come back safely.",
      "entries": [
        {
          "lineId": "abe.greeting.public",
          "channel": "greeting",
          "scope": "public",
          "topicId": "",
          "priority": 10,
          "conditions": [],
          "text": "Keep the road clear, and come back safely."
        },
        {
          "lineId": "abe.greeting.after-main",
          "channel": "greeting",
          "scope": "viewer",
          "topicId": "",
          "priority": 60,
          "conditions": [
            {
              "field": "main.complete",
              "key": "",
              "boolValue": true,
              "intValue": 0
            }
          ],
          "text": "You did the work and came back. That matters more than a tidy report."
        },
        {
          "lineId": "abe.main0.title",
          "channel": "main_title",
          "scope": "viewer",
          "topicId": "",
          "priority": 50,
          "conditions": [

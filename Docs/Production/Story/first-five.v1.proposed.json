            },
            {
              "field": "main.complete",
              "key": "",
              "boolValue": false,
              "intValue": 0
            }
          ],
          "text": "The Ashwood Captain"
        },
        {
          "lineId": "abe.main3.title",
          "channel": "main_title",
          "scope": "viewer",
          "topicId": "",
          "priority": 50,
          "conditions": [
            {
